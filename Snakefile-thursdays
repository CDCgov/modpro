def send_failure_email(subject, body):
    msg = EmailMessage()
    msg["To"] = EMAIL_TO
    msg["From"] = EMAIL_FROM
    msg["Subject"] = subject
    msg.set_content(body)
    with smtplib.SMTP("localhost") as smtp:
        smtp.send_message(msg)

def tail_file(path, n=80):
    path = Path(path)
    if not path.exists():
        return f"[missing: {path}]"
    try:
        return "\n".join(path.read_text(errors="replace").splitlines()[-n:])
    except Exception as e:
        return f"[could not read {path}: {e}]"

def newest_file(pattern):
    files = list(Path(".").glob(pattern))
    if not files:
        return None
    return max(files, key=lambda p: p.stat().st_mtime)

def recent_rule_log_tails(n_logs=8, n_lines=80):
    logs = sorted(
        Path(LOGGING_QC_DIR).glob("**/*.log"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )[:n_logs]
    if not logs:
        return "No rule logs found."
    return "\n".join(
        f"\n--- tail -n {n_lines} {log_path} ---\n{tail_file(log_path, n_lines)}"
        for log_path in logs
        )
onerror:
    newest_snakemake_log = newest_file(".snakemake/log/*.snakemake.log")
    snakemake_tail = (
        tail_file(newest_snakemake_log, 120)
        if newest_snakemake_log
        else "No Snakemake log found under .snakemake/log/"
    )
    body = f"""
Thursday/Rosetta Snakemake pipeline failed.

Host:
{socket.gethostname()}

Snakefile:
{workflow.snakefile}

Working directory:
{Path.cwd()}

Most recent Snakemake log:
{newest_snakemake_log}

===== Tail of Snakemake log =====

{snakemake_tail}


===== Recent rule log tails =====
{recent_rule_log_tails(n_logs=8, n_lines=80)}
"""
    try:
        send_failure_email("[modpro] Thursday Rosetta pipeline failed", body)
    except Exception as e:
        print(f"Failed to send failure email: {e}")

def metadata_file(wildcards):
    return f"{METADATA_DIR}/{wildcards.run}.txt"

def full_length_pdb_path(run, pdb_name):
    variant_hash = Path(pdb_name).stem
    candidates = list(
        Path("results").glob(
            f"*/openfold3/{variant_hash}/prediction/{variant_hash}_HA_trimer/seed_*/*_model.pdb"
            )
        )
    if not candidates:
        candidates = list(
            Path("results").glob(
                f"*/openfold3/{variant_hash}/prediction/**/*.pdb"
                )
            )
    if not candidates:
        raise FileNotFoundError(f"No OpenFold PDB found for variant {variant_hash}")
    candidates.sort(key=lambda p: p.stat().st_mtime)
    return str(candidates[-1])

def all_reference_pdbs(wildcards):
    refs = sorted(Path(REF_DIR).glob("*.pdb"))
    if not refs:
        raise ValueError(f"No reference PDBs found in {REF_DIR}")
    return [str(r) for r in refs]

checkpoint load_rosetta_manifest:
    input:
        manifest = f"{ROSETTA_MANIFEST_DIR}/{{run}}.tsv",
        metadata = metadata_file
    output:
        outdir = directory(f"{WORK_DIR}/{{run}}/inputs")
    run:
        outdir = Path(output.outdir)
        outdir.mkdir(parents=True, exist_ok=True)
        variants = []
        with open(input.manifest) as handle:
            for line in handle:
                pdb_name = line.strip()
                if not pdb_name:
                    continue
                variant_hash = Path(pdb_name).stem
                variants.append(
                    {
                        "variant_hash": variant_hash,
                        "full_length_pdb": full_length_pdb_path(
                            wildcards.run, pdb_name
                        ),
                    }
                )
        if not variants:
            raise ValueError(f"No variants found in manifest: {input.manifest}")
        with open(outdir / "variants.json", "w") as out:
            json.dump(variants, out, indent=2)

def get_variants(wildcards):
    ckpt = checkpoints.load_rosetta_manifest.get(run=wildcards.run)
    with open(Path(ckpt.output.outdir) / "variants.json") as handle:
        variants = json.load(handle)
    return [v["variant_hash"] for v in variants]

def variant_full_length_pdb(wildcards):
    ckpt = checkpoints.load_rosetta_manifest.get(run=wildcards.run)
    with open(Path(ckpt.output.outdir) / "variants.json") as handle:
        variants = json.load(handle)
    for v in variants:
        if v["variant_hash"] == wildcards.variant:
            return v["full_length_pdb"]
    raise ValueError(f"Variant not found in manifest: {wildcards.variant}")

def all_variant_done_files(wildcards):
    return expand(
        f"{FINAL_DIR}/{{run}}/{{variant}}/variant.done",
        run=wildcards.run,
        variant=get_variants(wildcards),
        )

