# --------------------------------------------------------------------------
# protein_modeling.logging, schema version 1
#
# One row per variant in the manifest, including variants that never got an
# OpenFold3 model and so were skipped. Runs after collate so the collated
# parquet is one of the artifacts it can see. Always succeeds if it can write
# the table: a FAIL row is data, not a pipeline error. thursday_complete is
# the rule that refuses to finish on FAIL.
# --------------------------------------------------------------------------
rule pipeline_status_table:
    input:
        inputs_dir = checkpoint_inputs_dir,
        variant_done = all_variant_done_files,
        collated = f"{RESULTS_DIR}/{{run_id}}/{{run_id}}_collated_data.parquet"
    output:
        parquet = PIPELINE_STATUS_PARQUET,
        tsv = PIPELINE_STATUS_TSV
    log:
        PIPELINE_STATUS_LOG
    params:
        # Wrapped in a lambda so Snakemake does NOT try to expand the literal
        # {run_id} / {variant_hash} inside the --step templates as wildcards.
        # They are placeholders for pipeline_status_table.py, not for this rule.
        steps = lambda wildcards: pipeline_status_step_args()
    shell:
        """
        source activate characterization
        mkdir -p "$(dirname "{output.parquet}")"
        mkdir -p "$(dirname "{log}")"
        mkdir -p "{STAGING_DIR}"

        {{
          echo "protein_modeling.logging v1 starting"
          date
          hostname
          echo "run_id={wildcards.run_id}"
        }} > "{log}" 2>&1

        python {SCRIPTS_DIR}/pipeline_status_table.py \
          --run-id {wildcards.run_id} \
          --variants-json "{input.inputs_dir}/variants.json" \
          {params.steps} \
          --output "{output.parquet}" \
          --tsv "{output.tsv}" \
          --staging-dir "{STAGING_DIR}" \
          >> "{log}" 2>&1

        test -s "{output.parquet}"

        {{
          echo "protein_modeling.logging v1 complete"
          date
        }} >> "{log}" 2>&1
        """

rule thursday_complete:
    input:
        variant_done = all_variant_done_files,
        variant_list = LOGGING["run_logs"]["variant_list"],
        collated_data = f"{RESULTS_DIR}/{{run_id}}/{{run_id}}_collated_data.parquet",
        status_parquet = PIPELINE_STATUS_PARQUET,
        status_tsv = PIPELINE_STATUS_TSV
    output:
        done = RUN_MARKERS["thursday_done"]
    log:
        LOGGING["run_logs"]["thursday_complete_log"]
    shell:
        """
        mkdir -p $(dirname {output.done})
        mkdir -p $(dirname {log})

        {{
          echo "Thursday pipeline finishing"
          date
          hostname
          echo "run_id={wildcards.run_id}"
          echo "results_dir={RESULTS_DIR}/{wildcards.run_id}"
          echo "logging_qc_dir={LOGGING_QC_DIR}/{wildcards.run_id}"
          echo "collated_data={input.collated_data}"
          echo "status_table={input.status_parquet}"
        }} > {log} 2>&1

        total=$(awk -F'\\t' 'NR>1' "{input.status_tsv}" | wc -l | tr -d ' ')
        failed=$(awk -F'\\t' 'NR>1 && $NF=="FAIL" {{print $1}}' "{input.status_tsv}")
        n_failed=$(echo -n "$failed" | grep -c . || true)

        {{
          echo "variants in protein_modeling.logging: $total"
          echo "variants with status FAIL: $n_failed"
        }} >> {log} 2>&1

        if [ "$n_failed" -gt 0 ]; then
          {{
            echo "ERROR: $n_failed of $total variants did not complete every step."
            echo "ERROR: status table: {input.status_tsv}"
            echo "FAIL variants:"
            echo "$failed" | sed 's/^/  /'
          }} >> {log} 2>&1
          echo "ERROR: $n_failed of $total variants FAIL; see {input.status_tsv} and {log}" >&2
          exit 1
        fi

        {{
          echo "Thursday pipeline complete: all $total variants SUCCESS"
          date
        }} >> {log} 2>&1

        touch {output.done}
        """


