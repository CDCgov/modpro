rule rosetta_relax:
    input:
        pdb = f"{ROSETTA_READY_DIR}/{{run}}/{{variant}}.pdb"
    output:
        relaxed = f"{WORK_DIR}/{{run}}/{{variant}}/relax/relaxed.pdb"
    log:
        f"{LOGGING_QC_DIR}/{{run}}/{{variant}}.relax.log"
    shell:
        """
        mkdir -p {WORK_DIR}/{wildcards.run}/{wildcards.variant}/relax
        mkdir -p {LOGGING_QC_DIR}/{wildcards.run}

        {{
          echo "rosetta relax starting"
          date
          hostname
          echo "pdb={input.pdb}"
          echo "binary={ROSETTA_RELAX}"
        }} > {log} 2>&1

        {ROSETTA_RELAX} \
          -quick \
          -ex1 \
          -ex2 \
          -overwrite \
          -relax:fast \
          -in:file:s {input.pdb} \
          -out:pdb \
          -out:prefix relaxed_ \
          -out:path:pdb {WORK_DIR}/{wildcards.run}/{wildcards.variant}/relax \
          >> {log} 2>&1

        relaxed_file=$(ls {WORK_DIR}/{wildcards.run}/{wildcards.variant}/relax/*.pdb 2>/dev/null | head -n 1)

        if [ -z "$relaxed_file" ]; then
          echo "ERROR: Rosetta relax produced no PDB" >> {log}
          exit 1
        fi

        cp "$relaxed_file" {output.relaxed}

        {{
          echo "rosetta relax complete"
          date
        }} >> {log} 2>&1
        """
