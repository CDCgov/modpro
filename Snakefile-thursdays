rule compare_to_reference:
    input:
        pdb = f"{WORK_DIR}/{{run}}/{{variant}}/best_energy/{{variant}}_best_energy_ha1.pdb",
        refs = all_reference_pdbs
    output:
        summary = f"{LOGGING_QC_DIR}/{{run}}/{{variant}}.reference_compare.tsv"
    log:
        f"{LOGGING_QC_DIR}/{{run}}/{{variant}}.reference_compare.log"
    shell:
        """
        mkdir -p {LOGGING_QC_DIR}/{wildcards.run}

        tmpdir={LOGGING_QC_DIR}/{wildcards.run}/{wildcards.variant}.reference_compare
        mkdir -p "$tmpdir"

        {{
          echo "reference comparison with Rosetta score_jd2 against all refs starting"
          date
          hostname
          echo "pdb={input.pdb}"
          echo "refs={input.refs}"
          echo "binary={ROSETTA_SCORE_JD2}"
        }} > {log} 2>&1

        echo -e "reference\\tscorefile" > {output.summary}

        for ref in {input.refs}; do
          ref_name=$(basename "$ref" .pdb)
          scorefile="$tmpdir/${{ref_name}}.score_jd2.sc"

          echo "comparing_to=$ref" >> {log}
          echo "scorefile=$scorefile" >> {log}

          {ROSETTA_SCORE_JD2} \
            -s {input.pdb} \
            -native "$ref" \
            -in:ignore_unrecognized_res \
            -overwrite \
            -out:file:scorefile "$scorefile" \
            >> {log} 2>&1

          echo -e "${{ref_name}}\\t${{scorefile}}" >> {output.summary}
        done

        {{
          echo "reference comparison complete"
          date
        }} >> {log} 2>&1
        """
