rule rosetta_score:
    input:
        pdb = ROSETTA["outputs"]["rosetta_ready_pdb"]
    output:
        done = ROSETTA["outputs"]["rosetta_score_done"],
        score_static = ROSETTA["logs"]["score_static_file"],
        score_jd2 = ROSETTA["logs"]["score_jd2_file"]
    log:
        ROSETTA["logs"]["rosetta_score_log"]
    shell:
        """
        mkdir -p $(dirname {output.done})
        mkdir -p $(dirname {log})
        {{
          echo "rosetta score raw HA1 starting"
          date
          hostname
          echo "pdb={input.pdb}"
          echo "score_binary={ROSETTA_SCORE}"
          echo "score_jd2_binary={ROSETTA_SCORE_JD2}"
        }} > {log} 2>&1

        {ROSETTA_SCORE} \\
          -s {input.pdb} \\
          -in:ignore_unrecognized_res \\
          -overwrite \\
          -out:file:scorefile {output.score_static} \\
          >> {log} 2>&1

        {ROSETTA_SCORE_JD2} \\
          -s {input.pdb} \\
          -in:ignore_unrecognized_res \\
          -overwrite \\
          -out:file:scorefile {output.score_jd2} \\
          >> {log} 2>&1

        touch {output.done}

        {{
          echo "rosetta score raw HA1 complete"
          date
        }} >> {log} 2>&1
        """

rule rosetta_relax:
    input:
        pdb = ROSETTA["outputs"]["rosetta_ready_pdb"]
    output:
        relaxed = ROSETTA["outputs"]["relaxed_pdb"]
    log:
        ROSETTA["logs"]["relax_log"]
    params:
        relax_dir = ROSETTA["outputs"]["relax_dir"]
    shell:
        """
        mkdir -p {params.relax_dir}
        mkdir -p $(dirname {log})
        {{
          echo "rosetta relax starting"
          date
          hostname
          echo "pdb={input.pdb}"
          echo "binary={ROSETTA_RELAX}"
          echo "relax_dir={params.relax_dir}"
        }} > {log} 2>&1

        {ROSETTA_RELAX} \\
          -quick \\
          -ex1 \\
          -ex2 \\
          -overwrite \\
          -relax:fast \\
          -in:file:s {input.pdb} \\
          -out:pdb \\
          -out:prefix relaxed_ \\
          -out:path:pdb {params.relax_dir} \\
          >> {log} 2>&1

        relaxed_file=$(ls {params.relax_dir}/*.pdb 2>/dev/null | head -n 1)

        if [ -z "$relaxed_file" ]; then
          echo "ERROR: Rosetta relax produced no PDB" >> {log}
          exit 1
        fi

        cp "$relaxed_file" {output.relaxed}

        {{
          echo "rosetta relax complete"
          date
        }} >> {log} 2>&1
        """

