        python {SCRIPTS_DIR}/dataframe_per_res.py \
          -i {output.raw} \
          -v {wildcards.variant_hash} \
          -t "$run_date" \
          -o "{output.parquet}" \
          --tsv "{output.per_res}" \
          >> {log} 2>&1

        test -s "{output.parquet}"
        mkdir -p "{STAGING_DIR}"
        cp -f "{output.parquet}" "{STAGING_DIR}/"
        """

