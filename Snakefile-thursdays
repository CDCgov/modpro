rule generate_metadata:
    input:
        manifest = f"{MANIFEST_DIR}/{{run_id}}.csv",
        inputs_dir = checkpoint_inputs_dir
    output:
        metadata = f"{MANIFEST_DIR}/{{run_id}}.metadata.csv"
    run:
        import csv
        records = load_variant_records(input.inputs_dir)
        Path(output.metadata).parent.mkdir(parents=True, exist_ok=True)
        with open(output.metadata, "w", newline="") as out:
            writer = csv.writer(out, delimiter=",")
            writer.writerow(["protein", "subtype", "variant_hash"])
            for record in records:
                writer.writerow(["HA", "H1", record["variant_hash"]])

rule write_variant_list:
    input:
        manifest = f"{MANIFEST_DIR}/{{run_id}}.csv",
        inputs_dir = checkpoint_inputs_dir
    output:
        variants = LOGGING["run_logs"]["variant_list"]
    log:
        LOGGING["run_logs"]["write_variant_list_log"]
    run:
        Path(output.variants).parent.mkdir(parents=True, exist_ok=True)
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        records = load_variant_records(input.inputs_dir)
        n_missing = 0
        with open(output.variants, "w") as out:
            out.write("run_id\tvariant_hash\tvariant_run_id\tfull_length_pdb\thas_model\n")
            for record in records:
                has_model = Path(record["full_length_pdb"]).is_file()
                n_missing += 0 if has_model else 1
                out.write(
                    f"{record['run_id']}\t"
                    f"{record['variant_hash']}\t"
                    f"{record['variant_run_id']}\t"
                    f"{record['full_length_pdb']}\t"
                    f"{has_model}\n"
                )
        with open(log[0], "w") as handle:
            handle.write(f"wrote variant list: {output.variants}\n")
            handle.write(f"variants: {len(records)}\n")
            handle.write(f"without an OpenFold3 model: {n_missing}\n")

