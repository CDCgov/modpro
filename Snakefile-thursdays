rule compare_to_reference:
    input:
        pdb = ROSETTA["outputs"]["best_energy_ha1_pdb"],
        refs = all_reference_pdbs
    output:
        summary = CHAR["outputs"]["reference_compare"]
    log:
        LOGGING["rule_logs"]["reference_compare_log"]
    shell:
        """
        source activate characterization
        mkdir -p $(dirname {output.summary})
        mkdir -p $(dirname {log})
        tmpdir={LOGGING_QC_DIR}/{wildcards.run_id}/{wildcards.variant_hash}.reference_compare
        mkdir -p "$tmpdir"
        # Clear stale score files. collate_pipeline_data globs *.sc here, so a
        # score file left by a reference that has since been removed from the
        # set would still be collated. This is how the excluded
        # relaxed_quick_* artifact kept showing up as a 13th reference.
        rm -f "$tmpdir"/*.sc
        {{
          echo "reference comparison with Rosetta score_jd2 against all refs starting"
          date
          hostname
          echo "pdb={input.pdb}"
          echo "refs={input.refs}"
          echo "binary={ROSETTA_SCORE_JD2}"
        }} > {log} 2>&1
        echo -e "reference\\tscorefile" > {output.summary}
        for ref in {input.refs}; do
          ref_name=$(basename "$ref" .pdb)
          scorefile="$tmpdir/${{ref_name}}.score_jd2.sc"

          {ROSETTA_SCORE_JD2} \\
            -s {input.pdb} \\
            -native "$ref" \\
            -in:ignore_unrecognized_res \\
            -overwrite \\
            -out:file:scorefile "$scorefile" \\
            >> {log} 2>&1

          echo -e "${{ref_name}}\\t${{scorefile}}" >> {output.summary}
        done

        {{
          echo "reference comparison complete"
          date
        }} >> {log} 2>&1
        """

