# run rosetta relax
rule rosetta_relax:
    input:
        pdb = f"{WORK_DIR}/{{run}}/{{variant}}/ha1/chainA_HA1.pdb"
    output:
        relaxed = f"{WORK_DIR}/{{run}}/{{variant}}/relax/relaxed.pdb",
        metrics = f"{LOGGING_QC_DIR}/{{run}}/{{variant}}.relax_metrics.tsv"
    log:
        f"{LOGGING_QC_DIR}/{{run}}/{{variant}}.relax.log"
    shell:
        """
        mkdir -p {WORK_DIR}/{wildcards.run}/{wildcards.variant}/relax
        mkdir -p {LOGGING_QC_DIR}/{wildcards.run}

        {{
          echo "rosetta relax starting"
          date
          hostname
          echo "run={wildcards.run}"
          echo "variant={wildcards.variant}"
          echo "pdb={input.pdb}"
          echo "binary={ROSETTA_RELAX}"
        }} >> {log} 2>&1

        {ROSETTA_RELAX} \
          -s {input.pdb} \
          -out:path:pdb {WORK_DIR}/{wildcards.run}/{wildcards.variant}/relax \
          >> {log} 2>&1

        relaxed_file=$(ls {WORK_DIR}/{wildcards.run}/{wildcards.variant}/relax/*relaxed*.pdb 2>/dev/null | head -n 1)

        if [ -z "$relaxed_file" ]; then
          relaxed_file=$(ls {WORK_DIR}/{wildcards.run}/{wildcards.variant}/relax/*.pdb 2>/dev/null | head -n 1)
        fi

        if [ -z "$relaxed_file" ]; then
          echo "ERROR: relax produced no pdb" >> {log}
          exit 1
        fi

        cp "$relaxed_file" {output.relaxed}

        python scripts/rosetta_qualitative_metrics.py \
          --pdb {output.relaxed} \
          --out {output.metrics} \
          --allow-nulls \
          >> {log} 2>&1

        {{
          echo "rosetta relax complete"
          date
        }} >> {log} 2>&1
        """

