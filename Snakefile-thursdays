def get_variants(wildcards):
    ckpt = checkpoints.load_rosetta_manifest.get(run=wildcards.run)
    variants_json = Path(ckpt.output.outdir) / "variants.json"
    with open(variants_json) as handle:
        variants = json.load(handle)
    return [v["variant_hash"] for v in variants]

def variant_full_length_pdb(wildcards):
    ckpt = checkpoints.load_rosetta_manifest.get(run=wildcards.run)
    variants_json = Path(ckpt.output.outdir) / "variants.json"
    with open(variants_json) as handle:
        variants = json.load(handle)
    for v in variants:
        if v["variant_hash"] == wildcards.variant:
            return v["full_length_pdb"]
    raise ValueError(f"Variant not found in manifest: {wildcards.variant}")

def metadata_file(wildcards):
    return f"{MANIFEST_DIR}/{wildcards.run}.txt"

def reference_for_run(wildcards):
    metadata = read_run_metadata(wildcards.run)
    subtype = metadata["subtype"]
    if subtype not in REFERENCE_BY_SUBTYPE:
        raise ValueError(
            f"Unsupported or missing subtype '{subtype}' for run {wildcards.run}"
        )
    return REFERENCE_BY_SUBTYPE[subtype]

