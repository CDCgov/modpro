# fail email
def send_failure_email(subject, body):
    msg = EmailMessage()
    msg["To"] = EMAIL_TO
    msg["From"] = EMAIL_FROM
    msg["Subject"] = subject
    msg.set_content(body)

    with smtplib.SMTP("localhost") as smtp:
        smtp.send_message(msg)

onerror:
    subject = "[modpro] Thursday Rosetta pipeline failed"

    body = f"""
Thursday/Rosetta Snakemake pipeline failed.

Host:
{socket.gethostname()}

Snakefile:
{workflow.snakefile}

Working directory:
{Path.cwd()}

Centralized logs:
{LOGGING_QC_DIR}/<run>/

Check the most recent Snakemake log under:
.snakemake/log/
"""
    try:
        send_failure_email(subject, body)
    except Exception as e:
        print(f"Failed to send failure email: {e}")

def normalize_subtype(subtype):
    s = subtype.strip().lower().replace("_", "-").replace(" ", "")
    if s.startswith("h3"):
        return "H3"
    if s.startswith("h1"):
        return "H1"
    if s in [
        "bvic",
        "b/vic",
        "bvictoria",
        "b/victoria",
        "hvic",
        "h/vic",
        "hvictoria",
        "h/victoria",
        "victoria",
        "vic"
    ]:
        return "Bvic"
    return "UNKNOWN"

def read_run_metadata(run):
    meta_path = Path(f"{MANIFEST_DIR}/{run}.txt")

    if not meta_path.exists():
        raise FileNotFoundError(f"Missing metadata file: {meta_path}")

    rows = []
    with open(meta_path) as handle:
        header = handle.readline().strip().split(",")

        for line in handle:
            line = line.strip()
            if not line:
                continue

            values = line.split(",", 2)
            row = dict(zip(header, values))
            rows.append(row)
    if not rows:
        raise ValueError(f"No metadata rows found in {meta_path}")
    proteins = sorted(set(r.get("protein", "").strip() for r in rows if r.get("protein", "").strip()))
    subtypes = sorted(set(r.get("subtype", "").strip() for r in rows if r.get("subtype", "").strip()))
    protein = proteins[0] if proteins else "UNKNOWN"
    normalized_subtypes = [
        normalize_subtype(s)
        for s in subtypes
    ]
    if "H3" in normalized_subtypes:
        subtype = "H3"
    elif "H1" in normalized_subtypes:
        subtype = "H1"
    elif "Bvic" in normalized_subtypes:
        subtype = "Bvic"
    else:
        subtype = "UNKNOWN"
        }

