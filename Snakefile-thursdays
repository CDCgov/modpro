rule write_variant_list:
    input:
        manifest = f"{ROSETTA_MANIFEST_DIR}/{{run}}.tsv"
    output:
        variants = f"{LOGGING_QC_DIR}/{{run}}/variant_list.tsv"
    log:
        f"{LOGGING_QC_DIR}/{{run}}/write_variant_list.log"
    run:
        Path(output.variants).parent.mkdir(parents=True, exist_ok=True)
        with open(output.variants, "w") as out:
            out.write("variant_hash\tfull_length_pdb\n")
            with open(input.manifest) as handle:
                for line in handle:
                    pdb_name = line.strip()
                    if not pdb_name:
                        continue
                    variant_hash = Path(pdb_name).stem
                    full_path = full_length_pdb_path(wildcards.run, pdb_name)
                    out.write(f"{variant_hash}\t{full_path}\n")
        with open(log[0], "w") as l:
            l.write(f"wrote variant list: {output.variants}\n")

