# --------------------------------------------------------------------------
# protein_modeling.logging (schema v1)
#
# The config values below are already path templates containing {run_id} and
# {variant_hash}, so they are handed to pipeline_status_table.py as-is. A step
# is True when every file listed for it exists and is non-empty.
#
# sia_dock is intentionally absent: not implemented, written as null, and not
# counted when deciding SUCCESS vs FAIL.
# --------------------------------------------------------------------------
MSA_DONE_TEMPLATE = OF3["outputs"].get(
    "msa_done",
    f"{RESULTS_DIR}/{{run_id}}/openfold3/{{variant_hash}}/msa/msa.done",
)
# The parquet and TSV are prefixed with run_id. They are copied into the
# shared staging directory, which is flat, so an unprefixed
# protein_modeling_logging_v1.parquet would be overwritten by the next run.
PIPELINE_STATUS_PARQUET = LOGGING["run_logs"].get(
    "pipeline_status_parquet",
    f"{LOGGING_QC_DIR}/{{run_id}}/{{run_id}}_protein_modeling_logging_v1.parquet",
)
PIPELINE_STATUS_TSV = LOGGING["run_logs"].get(
    "pipeline_status_tsv",
    f"{LOGGING_QC_DIR}/{{run_id}}/{{run_id}}_protein_modeling_logging_v1.tsv",
)
PIPELINE_STATUS_LOG = LOGGING["run_logs"].get(
    "pipeline_status_log",
    f"{LOGGING_QC_DIR}/{{run_id}}/pipeline_status_table.log",
)

PIPELINE_STATUS_STEPS = {
    "msa_done": [MSA_DONE_TEMPLATE],
    "structure_done": [OF3["outputs"]["model_pdb"]],
    "rosetta_relax_done": [ROSETTA["outputs"]["relaxed_pdb"]],
    "rosetta_score": [
        ROSETTA["outputs"]["rosetta_score_done"],
        ROSETTA["logs"]["relaxed_score_file"],
    ],
    "glyc_distance": [CHAR["outputs"]["glycosylation_distance_parquet"]],
    "structural_distance": [
        CHAR["outputs"]["structural_distance_heavy"],
        CHAR["outputs"]["structural_distance_calpha"],
        CHAR["outputs"]["structural_distance_carbon"],
    ],
    "epitope_calc": [CHAR["outputs"]["epitope_calculation_parquet"]],
}

def pipeline_status_step_args():
    """--step NAME=TEMPLATE|TEMPLATE ... for pipeline_status_table.py"""
    return " ".join(
        "--step '{}={}'".format(name, "|".join(templates))
        for name, templates in PIPELINE_STATUS_STEPS.items()
    )


def fmt(template, **kwargs):
    return template.format(**kwargs)

def variant_run_id(run_id, variant_hash):
    return f"{run_id}_{variant_hash}"

def run_date_from_id(run_id):
    """Return YYYY-MM-DD from the first eight characters of run_id."""
    date_text = run_id[:8]
    if len(date_text) != 8 or not date_text.isdigit():
        raise ValueError(
            f"run_id must start with an eight-digit YYYYMMDD date: {run_id}"
        )
    return f"{date_text[:4]}-{date_text[4:6]}-{date_text[6:8]}"

def send_failure_email(subject, body):
    msg = EmailMessage()
    msg["To"] = EMAIL_TO
    msg["From"] = EMAIL_FROM
    msg["Subject"] = subject
    msg.set_content(body)
    with smtplib.SMTP("localhost") as smtp:
        smtp.send_message(msg)

def tail_file(path, n=80):
    path = Path(path)
    if not path.exists():
        return f"[missing: {path}]"
    try:
        return "\n".join(path.read_text(errors="replace").splitlines()[-n:])
    except Exception as e:
        return f"[could not read {path}: {e}]"

def recent_rule_log_tails(n_logs=8, n_lines=80):
    logs = sorted(
        Path(LOGGING_QC_DIR).glob("**/*.log"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )[:n_logs]
    if not logs:
        return "No rule logs found."
    return "\n".join(
        f"\n--- tail -n {n_lines} {log_path} ---\n{tail_file(log_path, n_lines)}"
        for log_path in logs
    )

def runs_in_flight():
    """(run_id, variants.json) for runs loaded but with no thursday.done yet."""
    out = []
    for variants_json in sorted(Path(RESULTS_DIR).glob("*/inputs/variants.json")):
        run_id = variants_json.parent.parent.name
        marker = Path(fmt(RUN_MARKERS["thursday_done"], run_id=run_id))
        if not marker.exists():
            out.append((run_id, variants_json))
    return out

def status_table_command(run_id, variants_json):
    return (
        "source activate characterization && "
        f"python {SCRIPTS_DIR}/pipeline_status_table.py "
        f"--run-id {run_id} "
        f"--variants-json {variants_json} "
        f"{pipeline_status_step_args()} "
        f"--output {fmt(PIPELINE_STATUS_PARQUET, run_id=run_id)} "
        f"--tsv {fmt(PIPELINE_STATUS_TSV, run_id=run_id)} "
        f"--staging-dir {STAGING_DIR}"
    )

def build_status_tables_for_runs_in_flight():
    """Rebuild protein_modeling.logging for each unfinished run. Returns text.

    Uses subprocess, NOT Snakemake's shell(). shell() runs its argument
    through Snakemake's formatter, which would try to resolve the literal
    {run_id} / {variant_hash} inside the --step templates as variables and
    raise "The name 'variant_hash' is unknown in this context".
    """
    import subprocess

    summaries = []
    for run_id, variants_json in runs_in_flight():
        cmd = status_table_command(run_id, variants_json)
        try:
            proc = subprocess.run(
                cmd,
                shell=True,
                executable="/bin/bash",
                capture_output=True,
                text=True,
                timeout=600,
            )
            out = (proc.stdout or "").strip()
            if proc.returncode != 0:
                err = (proc.stderr or "").strip().splitlines()[-5:]
                out = (
                    f"run_id={run_id}: status table command exited "
                    f"{proc.returncode}\n" + "\n".join(err)
                )
            summaries.append(out or f"run_id={run_id}: (no output)")
        except Exception as e:
            summaries.append(f"run_id={run_id}: could not build status table: {e}")
    return "\n\n".join(summaries) if summaries else "No runs in flight."


# Snakemake injects only `log` here: the path to this run's snakemake log.
onerror:
    status_text = build_status_tables_for_runs_in_flight()
    body = f"""
Thursday/Rosetta Snakemake pipeline failed.

Host:
{socket.gethostname()}

Snakefile:
{workflow.snakefile}

Working directory:
{Path.cwd()}

Snakemake log:
{log}

===== protein_modeling.logging (also written under {LOGGING_QC_DIR}/<run_id>/) =====

{status_text}

===== Tail of Snakemake log =====

{tail_file(log, 120)}

===== Recent rule log tails =====

{recent_rule_log_tails(n_logs=8, n_lines=80)}
"""
    print(body)
    try:
        send_failure_email("[modpro] Thursday Rosetta pipeline failed", body)
    except Exception as e:
        print(f"Failed to send failure email: {e}")

def metadata_file(wildcards):
    return f"{MANIFEST_DIR}/{wildcards.run_id}.metadata.csv"

def full_length_pdb_path(run_id, variant_hash):
    return fmt(
        OF3["outputs"]["model_pdb"],
        run_id=run_id,
        variant_hash=variant_hash,
    )

def variant_full_length_pdb(wildcards):
    """Input function for the first Rosetta rule.

    get_runnable_variants already filters out variants with no model, so this
    should not fire. It stays as a guard that says where to look.
    """
    path = full_length_pdb_path(wildcards.run_id, wildcards.variant_hash)
    if not Path(path).exists():
        raise FileNotFoundError(
            f"No OpenFold3 PDB found for run_id={wildcards.run_id}, "
            f"variant_hash={wildcards.variant_hash}: {path}. "
            f"Check {RESULTS_DIR}/{wildcards.run_id}/openfold3/prediction_report.tsv "
            "written by the Monday pipeline."
        )
    return path

# --------------------------------------------------------------------------
# Reference selection
#
# refs/ holds more than the reference set. A bare glob("*.pdb") there matched
# 13 files on 2026-10-27:
#     6  real references        B/H1/H3 x reference/seasonal
#     6  relaxed counterparts   relaxed_<same six>
#     1  pipeline artifact      relaxed_quick_<variant hash>_0001.pdb
# The .bak copies and trim.py are already excluded by the *.pdb pattern.
#
# DECISION 2026-10-27: all 12 of the first two groups are deliberate
# references and are kept. Each variant is scored against all 12, and collate
# writes one row per variant-reference pair. Do not "tidy" the relaxed_
# copies away; they are wanted.
#
# The 13th file is NOT a reference. It is a Rosetta relax output (this
# workflow's own -out:prefix relaxed_ plus Rosetta's _0001, named after a
# variant hash) that ended up in refs/. It is a full-length trimer, so
# scoring a 327-residue HA1 monomer against it produced
# "In CA_rmsd 1647 residues selected but only 327 protein CA atoms found"
# and a meaningless rms. It is excluded by default, and deleting it from
# refs/ would be reasonable too.
#
# Override in config.yaml under paths:
#     refs_include: ["H1_HA_reference.pdb", ...]   # exact list, wins outright
#     refs_exclude: ["relaxed_quick_*"]            # glob patterns to drop
# --------------------------------------------------------------------------
REFS_INCLUDE = PATHS.get("refs_include") or None
REFS_EXCLUDE = PATHS.get("refs_exclude", ["relaxed_quick_*"])

def selected_reference_pdbs():
    """The reference PDBs to score against, after include/exclude rules."""
    import fnmatch

    ref_dir = Path(REF_DIR)
    if REFS_INCLUDE:
        refs, missing = [], []
        for name in REFS_INCLUDE:
            p = ref_dir / name
            (refs if p.is_file() else missing).append(p if p.is_file() else name)
        if missing:
            raise ValueError(
                f"paths.refs_include names files not present in {REF_DIR}: {missing}"
            )
        return sorted(refs)

    all_pdbs = sorted(ref_dir.glob("*.pdb"))
    refs, dropped = [], []
    for p in all_pdbs:
        if any(fnmatch.fnmatch(p.name, pat) for pat in REFS_EXCLUDE):
            dropped.append(p.name)
        else:
            refs.append(p)
    if dropped:
        print(
            f"[Snakefile-thursdays] excluding {len(dropped)} file(s) in {REF_DIR} "
            f"matching {REFS_EXCLUDE}: {', '.join(dropped)}"
        )
    return refs

_REFS_ANNOUNCED = False

def all_reference_pdbs(wildcards):
    global _REFS_ANNOUNCED
    refs = selected_reference_pdbs()
    if not refs:
        raise ValueError(
            f"No reference PDBs selected from {REF_DIR} "
            f"(exclude patterns: {REFS_EXCLUDE})"
        )
    if not _REFS_ANNOUNCED:
        _REFS_ANNOUNCED = True
        print(
            f"[Snakefile-thursdays] scoring each variant against {len(refs)} "
            f"reference(s): {', '.join(p.name for p in refs)}"
        )
    return [str(r) for r in refs]

checkpoint load_run_manifest:
    input:
        manifest = f"{MANIFEST_DIR}/{{run_id}}.csv"
    output:
        outdir = directory(f"{RESULTS_DIR}/{{run_id}}/inputs")
    run:
        outdir = Path(output.outdir)
        outdir.mkdir(parents=True, exist_ok=True)
        lines = [line.strip() for line in open(input.manifest) if line.strip()]
        records = []
        i = 0
        while i < len(lines):
            variant_hash = lines[i].lstrip(">").strip()
            if i + 1 >= len(lines):
                raise ValueError(
                    f"Manifest {input.manifest} variant hash has no sequence: {variant_hash}"
                )
            sequence = lines[i + 1].strip().upper()
            if not variant_hash:
                raise ValueError(f"Empty variant hash found in {input.manifest}")
            if not sequence:
                raise ValueError(f"Empty sequence found for {variant_hash}")
            records.append({
                "run_id": wildcards.run_id,
                "variant_hash": variant_hash,
                "variant_run_id": variant_run_id(wildcards.run_id, variant_hash),
                "full_length_pdb": full_length_pdb_path(wildcards.run_id, variant_hash),
                "sequence_length": len(sequence),
            })
            i += 2
        if not records:
            raise ValueError(f"No records found in manifest: {input.manifest}")
        with open(outdir / "variants.json", "w") as out:
            json.dump(records, out, indent=2)

# --------------------------------------------------------------------------
# Checkpoint access
#
# checkpoints.<name>.get() may ONLY be called while Snakemake is resolving a
# rule's input, never from a run: or shell: body. A rule that needs the
# variant list declares checkpoint_inputs_dir as an input and then reads
# variants.json from that path with load_variant_records().
# --------------------------------------------------------------------------
def checkpoint_inputs_dir(wildcards):
    """Input function: the checkpoint's output directory."""
    return checkpoints.load_run_manifest.get(run_id=wildcards.run_id).output.outdir

def load_variant_records(inputs_dir):
    """Plain file read. Safe to call from a rule body."""
    with open(Path(inputs_dir) / "variants.json") as handle:
        return json.load(handle)

def get_variant_records(wildcards):
    """Input-function-only helper: every variant in the manifest."""
    return load_variant_records(checkpoint_inputs_dir(wildcards))

def get_variants(wildcards):
    return [r["variant_hash"] for r in get_variant_records(wildcards)]

_WARNED_MISSING_MODELS = set()

def get_runnable_variants(wildcards):
    """Variants with an OpenFold3 model, i.e. the ones Thursday can process.

    The rest are named once while the DAG is built and show up as
    structure_done=False / FAIL in protein_modeling.logging.
    """
    records = get_variant_records(wildcards)
    runnable = [r["variant_hash"] for r in records if Path(r["full_length_pdb"]).is_file()]
    missing = [r["variant_hash"] for r in records if not Path(r["full_length_pdb"]).is_file()]
    if missing and wildcards.run_id not in _WARNED_MISSING_MODELS:
        _WARNED_MISSING_MODELS.add(wildcards.run_id)
        print(
            f"[Snakefile-thursdays] WARNING run_id={wildcards.run_id}: "
            f"{len(missing)} of {len(records)} variants have no OpenFold3 model "
            f"and will be skipped: {', '.join(missing)}. "
            f"They are recorded as FAIL in protein_modeling.logging. See "
            f"{RESULTS_DIR}/{wildcards.run_id}/openfold3/prediction_report.tsv "
            "from the Monday pipeline."
        )
    return runnable

def all_variant_done_files(wildcards):
    return expand(
        CHAR["outputs"]["variant_done"],
        run_id=wildcards.run_id,
        variant_hash=get_runnable_variants(wildcards),
    )

rule all:
    input:
