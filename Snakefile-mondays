def _detect_gpu_count():
    try:
        out = subprocess.run(
            ["nvidia-smi", "-L"], capture_output=True, text=True, timeout=10
        ).stdout
        return sum(1 for line in out.splitlines() if line.startswith("GPU "))
    except Exception:
        return None

