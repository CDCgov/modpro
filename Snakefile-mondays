# break up manifest to single aa seq per fasta
checkpoint split_manifest:
    input:
        manifest = f"{MANIFEST_DIR}/{{manifest}}.csv"
    output:
        outdir = directory("results/{manifest}/variants")
    run:
        outdir = Path(output.outdir)
        outdir.mkdir(parents=True, exist_ok=True)
        lines = [
            line.strip()
            for line in open(input.manifest)
            if line.strip()
        ]
        records = []
        i = 0
        while i < len(lines):
            variant_hash = lines[i].lstrip(">").strip()
            if i + 1 >= len(lines):
                raise ValueError(
                    f"Manifest {input.manifest} variant hash has no sequence: {variant_hash}"
                )
            sequence = lines[i + 1].strip().upper()
            if not variant_hash:
                raise ValueError(f"Empty variant hash found in {input.manifest}")
            if not sequence:
                raise ValueError(f"Empty sequence found for {variant_hash}")
            records.append((variant_hash, sequence))
            i += 2
        if not records:
            raise ValueError(f"No sequence records found in {input.manifest}")
        seen = set()
        manifest_records = []
        for variant_hash, sequence in records:
            if variant_hash in seen:
                continue
            seen.add(variant_hash)
            fasta_path = outdir / f"{variant_hash}.fasta"
            with open(fasta_path, "w") as out:
                out.write(f">{variant_hash}\n")
                out.write(f"{sequence}\n")
            manifest_records.append({
                "variant_hash": variant_hash,
                "fasta": str(fasta_path),
                "sequence_length": len(sequence)
            })
        with open(outdir / "variants.json", "w") as out:
            json.dump(manifest_records, out, indent=2)

# get variant hashes
def get_variants(wildcards):
    ckpt = checkpoints.split_manifest.get(manifest=wildcards.manifest)
    variants_json = Path(ckpt.output.outdir) / "variants.json"
    with open(variants_json) as handle:
        records = json.load(handle)
    return [r["variant_hash"] for r in records]

# define variant hash task list - msa
def all_msa_done(wildcards):
    variants = get_variants(wildcards)
    return expand(
        "results/{manifest}/openfold3/{variant}/msa/msa.done",
        manifest=wildcards.manifest,
        variant=variants
    )

# define variant hash task list - inference
def all_prediction_done(wildcards):
    variants = get_variants(wildcards)
    return expand(
        "results/{manifest}/openfold3/{variant}/prediction/prediction.done",
        manifest=wildcards.manifest,
        variant=variants
    )

# msa configs
rule create_msa_config:
    input:
        fasta = "results/{manifest}/variants/{variant}.fasta"
    output:
        msa_config = "results/{manifest}/openfold3/{variant}/msa_config.json"
    run:
        outdir = Path(f"results/{wildcards.manifest}/openfold3/{wildcards.variant}/msa")
        outdir.mkdir(parents=True, exist_ok=True)
        cfg = {
            "input_fasta": str(Path(input.fasta).resolve()),
            "openfold_env": OPENFOLD_ENV,
            "databases": ["uniref90", "uniprot", "mgnify", "bfd"],
            "base_database_path": OPENFOLD_DB_PATH,
            "output_directory": str(outdir.resolve()),
            "jackhmmer_output_format": "sto",
            "jackhmmer_threads": JACKHMMER_THREADS,
            "hhblits_threads": HHBLITS_THREADS,
            "tmpdir": "/tmp",
            "run_template_search": False
        }
        Path(output.msa_config).parent.mkdir(parents=True, exist_ok=True)
        with open(output.msa_config, "w") as out:
            json.dump(cfg, out, indent=2)

rule run_openfold3_msa:
    input:
        msa_config = "results/{manifest}/openfold3/{variant}/msa_config.json"
    output:
        done = "results/{manifest}/openfold3/{variant}/msa/msa.done"
    threads:
        MSA_CORES
    resources:
        msa_slots = 1
    params:
        msa_snakefile = OPENFOLD3_MSA_SNAKEFILE
    log:
        "results/{manifest}/logs/{variant}.msa.log"
    shell:
        """
        module load cuda
        mkdir -p results/{wildcards.manifest}/logs
        {{
          echo "msa generation starting"
          date
          hostname
          echo "manifest={wildcards.manifest}"
          echo "variant={wildcards.variant}"
          echo "msa_config={input.msa_config}"
          echo "msa_snakefile={params.msa_snakefile}"
          echo "threads={threads}"
          echo "pwd=$(pwd)"
        }} >> {log} 2>&1
        snakemake \
          -s {params.msa_snakefile} \
          --configfile {input.msa_config} \
          --cores {threads} \
          --nolock \
          --keep-going \
          --latency-wait 120 \
          --rerun-incomplete \
          --printshellcmds \
          >> {log} 2>&1
        {{
          echo "msa generation complete"
          date
        }} >> {log} 2>&1
        touch {output.done}
        """
# create json configs
rule create_query_json:
    input:
        fasta = "results/{manifest}/variants/{variant}.fasta",
        msa_done = "results/{manifest}/openfold3/{variant}/msa/msa.done"
    output:
        query_json = "results/{manifest}/openfold3/{variant}/query.json"
    run:
        lines = [line.strip() for line in open(input.fasta) if line.strip()]
        if len(lines) < 2:
            raise ValueError(f"Invalid FASTA: {input.fasta}")
        name = lines[0].replace(">", "")
        sequence = "".join(lines[1:])
        msa_path = str(
            Path(f"results/{wildcards.manifest}/openfold3/{wildcards.variant}/msa/{name}").resolve()
        )
        query = {
            "queries": {
                f"{name}_HA_trimer": {
                    "chains": [
                        {
                            "molecule_type": "protein",
                            "chain_ids": HA_CHAIN_IDS,
                            "sequence": sequence,
                            "main_msa_file_paths": [msa_path]
                        }
                    ],
                    "use_msas": True,
                    "use_paired_msas": True,
                    "use_main_msas": True
                }
            }
        }
        Path(output.query_json).parent.mkdir(parents=True, exist_ok=True)
        with open(output.query_json, "w") as out:
            json.dump(query, out, indent=2)


rule run_openfold3_prediction:
    input:
        query_json = "results/{manifest}/openfold3/{variant}/query.json"
    output:
        done = "results/{manifest}/openfold3/{variant}/prediction/prediction.done"
    params:
        output_dir = "results/{manifest}/openfold3/{variant}/prediction",
        runner_yaml = RUNNER_YAML,
        model_pdb = lambda wc: str(model_pdb_path(wc.manifest, wc.variant)),
        min_free_gpu_mib = MIN_FREE_GPU_MIB
    threads: 1
    resources:
        inference_slots = 1,
        mem_gb = INFERENCE_MEM_GB
    log:
        "results/{manifest}/logs/{variant}.prediction.log"
    shell:
        """
        mkdir -p {params.output_dir}
        mkdir -p results/{wildcards.manifest}/logs
        {{
          echo "starting inference"
          date
          hostname
          source activate /scicomp/groups/ID-VSDB/GAT/shared_conda_envs/of3-inf-env
          module load cuda
          echo "manifest={wildcards.manifest}"
          echo "variant={wildcards.variant}"
          echo "query_json={input.query_json}"
          echo "output_dir={params.output_dir}"
          echo "runner_yaml={params.runner_yaml}"
          echo "expected_model={params.model_pdb}"
          echo "pwd=$(pwd)"
          echo "GPU?"
          nvidia-smi || true
          env | sort
        }} >> {log} 2>&1

        # --- GPU pre-flight -------------------------------------------------
        min_free={params.min_free_gpu_mib}
        if command -v nvidia-smi >/dev/null 2>&1; then
          free_mib=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ' ')
          {{
            echo "gpu_free_mib=${{free_mib:-unknown}} (minimum required: ${{min_free}})"
            echo "compute processes currently on the GPU:"
            nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv 2>/dev/null || echo "(none / unavailable)"
          }} >> {log} 2>&1
          if [ -n "${{free_mib}}" ] && [ "${{free_mib}}" -lt "${{min_free}}" ]; then
            echo "ERROR: GPU has only ${{free_mib}} MiB free, below the ${{min_free}} MiB one prediction needs. Something else is on the GPU (see list above). Not starting variant {wildcards.variant}." >> {log}
            exit 1
          fi
        fi

        export PYTORCH_ALLOC_CONF=expandable_segments:True

        # --- run ------------------------------------------------------------
        prediction_exit_code=0
        run_openfold predict \
          --query_json {input.query_json} \
          --use_msa_server=False \
          --output_dir {params.output_dir} \
          --runner_yaml {params.runner_yaml} \
          >> {log} 2>&1 || prediction_exit_code=$?

        {{
          echo "run_openfold exited with code ${{prediction_exit_code}}"
          date
        }} >> {log} 2>&1

        # --- collect per-query error logs OpenFold3 may have written --------
        for f in {params.output_dir}/logs/predict_err_rank*.log; do
          if [ -f "$f" ]; then
            {{
              echo "--- per-query error log: $f ---"
              cat "$f"
              echo "--- end $f ---"
            }} >> {log} 2>&1
          fi
        done

        if [ "${{prediction_exit_code}}" -ne 0 ]; then
          echo "ERROR: run_openfold failed with exit code ${{prediction_exit_code}} for variant {wildcards.variant}" >> {log}
          exit "${{prediction_exit_code}}"
        fi

        # --- done means a model exists; nothing else counts -----------------
        if [ ! -s {params.model_pdb} ]; then
          {{
            echo "ERROR: run_openfold exited 0 but produced no model for variant {wildcards.variant}"
            echo "ERROR: expected {params.model_pdb}"
            echo "--- summary.txt ---"
            cat {params.output_dir}/summary.txt 2>/dev/null || echo "(no summary.txt)"
          }} >> {log} 2>&1
          exit 1
        fi

        {{
          echo "inference complete: {params.model_pdb}"
          date
        }} >> {log} 2>&1
        touch {output.done}
        """
# check for completion - msa
rule manifest_msa_complete:
    input:
        all_msa_done
    output:
        done = "results/{manifest}/openfold3/msa.done"
    shell:
        "touch {output.done}"

# check for completion - inference

rule manifest_prediction_complete:
    input:
        all_prediction_done
    output:
        done = "results/{manifest}/openfold3/manifest.done"
    run:
        rows = prediction_status(wildcards.manifest)
        report_path = write_prediction_report(wildcards.manifest, rows)
        bad = [r for r in rows if r["status"] != "ok"]
        if bad:
            removed = []
            for r in bad:
                if r["status"] == "STALE_DONE_NO_MODEL":
                    Path(r["done_marker"]).unlink(missing_ok=True)
                    removed.append(r["variant"])
            msg = [
                f"Manifest {wildcards.manifest}: {len(bad)} of {len(rows)} variants have no model.",
                f"Report: {report_path}",
                format_report(wildcards.manifest, rows),
            ]
            if removed:
                msg.append(
                    f"Deleted {len(removed)} stale prediction.done marker(s) with no model behind them: "
                    + ", ".join(removed)
                )
                msg.append("Rerun the same snakemake command to regenerate those variants.")
            raise WorkflowError("\n".join(msg))
        Path(output.done).touch()

