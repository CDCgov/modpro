        if _name in _budgets:
            print(f"[Snakefile-mondays] resource budget {_name}={_budgets[_name]} (from command line)")
        else:
            _budgets[_name] = _limit
            print(f"[Snakefile-mondays] resource budget {_name}={_limit} (set by Snakefile)")
except (AttributeError, TypeError) as _e:
    raise WorkflowError(
        "Could not install resource budgets into workflow.global_resources "
        f"({_e!r}). This Snakemake version keeps budgets elsewhere. Launch with "
        f"--resources inference_slots={INFERENCE_SLOTS} msa_slots={MSA_SLOTS} "
        "or the GPU will be oversubscribed."
    )

