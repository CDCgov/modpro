def model_pdb_path(manifest, variant):
    return (
        Path("results") / manifest / "openfold3" / variant / "prediction"
        / f"{variant}_HA_trimer" / f"seed_{OPENFOLD3_SEED}"
        / f"{variant}_HA_trimer_seed_{OPENFOLD3_SEED}_sample_1_model.pdb"
    )

def _manifest_variants(manifest):
    variants_json = Path("results") / manifest / "variants" / "variants.json"
    if not variants_json.exists():
        return []
    with open(variants_json) as handle:
        return [r["variant_hash"] for r in json.load(handle)]

def prediction_status(manifest):
    """One dict per variant: status, error type/message, where to look."""
    rows = []
    for v in _manifest_variants(manifest):
        pdir = Path("results") / manifest / "openfold3" / v / "prediction"
        model = model_pdb_path(manifest, v)
        done = pdir / "prediction.done"
        snk_log = Path("results") / manifest / "logs" / f"{v}.prediction.log"

        err_type, err_msg = "", ""
        for errlog in sorted(pdir.glob("logs/predict_err_rank*.log")):
            for line in errlog.read_text(errors="replace").splitlines():
                if line.startswith("Error Type:"):
                    err_type = line.split(":", 1)[1].strip()
                elif line.startswith("Error Message:") and not err_msg:
                    err_msg = line.split(":", 1)[1].strip()[:200]

        snk_errors = []
        if snk_log.exists():
            snk_errors = [
                l for l in snk_log.read_text(errors="replace").splitlines()
                if l.startswith("ERROR:")
            ]

        if model.exists() and model.stat().st_size > 0:
            status = "ok"
        elif done.exists():
            status = "STALE_DONE_NO_MODEL"
        elif err_type or snk_errors:
            status = "FAILED"
        elif pdir.exists():
            status = "INCOMPLETE"
        else:
            status = "NOT_RUN"

        rows.append({
            "variant": v,
            "status": status,
            "error_type": err_type,
            "error_message": err_msg or (snk_errors[-1] if snk_errors else ""),
            "snakemake_log": str(snk_log),
            "model_pdb": str(model),
            "done_marker": str(done),
        })
    return rows

def write_prediction_report(manifest, rows=None):
    rows = prediction_status(manifest) if rows is None else rows
    # NB: "report" is a reserved Snakemake directive; never use it as a name.
    report_path = Path("results") / manifest / "openfold3" / "prediction_report.tsv"
    report_path.parent.mkdir(parents=True, exist_ok=True)
    cols = ["variant", "status", "error_type", "error_message",
            "snakemake_log", "model_pdb"]
    with open(report_path, "w") as out:
        out.write("\t".join(cols) + "\n")
        for r in rows:
            out.write("\t".join(str(r[c]).replace("\t", " ") for c in cols) + "\n")
    return report_path

def format_report(manifest, rows):
    n_ok = sum(r["status"] == "ok" for r in rows)
    lines = [f"Manifest {manifest}: {n_ok}/{len(rows)} variants have a model"]
    for r in rows:
        if r["status"] == "ok":
            continue
        line = f"  {r['variant']}  {r['status']}"
        if r["error_type"]:
            line += f"  [{r['error_type']}]"
        if r["error_message"]:
            line += f"  {r['error_message']}"
        lines.append(line)
        lines.append(f"      log: {r['snakemake_log']}")
    return "\n".join(lines)

def manifests_in_flight():
    """Manifests that have been split but not yet marked complete."""
    out = []
    for vj in sorted(Path("results").glob("*/variants/variants.json")):
        manifest = vj.parent.parent.name
        if not (Path("results") / manifest / "openfold3" / "manifest.done").exists():
            out.append(manifest)
    return out

def send_email(subject, body):
    msg = EmailMessage()
    msg["To"] = EMAIL_TO
    msg["From"] = EMAIL_FROM
    msg["Subject"] = subject
    msg.set_content(body)
    with smtplib.SMTP("localhost") as smtp:
        smtp.send_message(msg)

def _snakemake_log_tail(log, n=100):
    try:
        return "\n".join(Path(log).read_text(errors="replace").splitlines()[-n:])
    except Exception as e:
        return f"(could not read snakemake log {log}: {e})"

onerror:
    reports = []
    for manifest in manifests_in_flight():
        try:
            rows = prediction_status(manifest)
            write_prediction_report(manifest, rows)
            reports.append(format_report(manifest, rows))
        except Exception as e:
            reports.append(f"Manifest {manifest}: could not build report ({e})")
    body = f"""
Snakemake Monday pipeline FAILED.

Host:              {socket.gethostname()}
Snakefile:         {workflow.snakefile}
Working directory: {Path.cwd()}
Snakemake log:     {log}

Per-variant status (also in results/<manifest>/openfold3/prediction_report.tsv):
{chr(10).join(reports) if reports else '(no manifests in flight)'}

Last 100 lines of snakemake log:
{_snakemake_log_tail(log)}
"""
    print(body)
    try:
        send_email("[modpro] Snakemake OpenFold3 Monday pipeline FAILED", body)
    except Exception as e:
        print(f"Failed to send failure email: {e}")

onsuccess:
    if EMAIL_ON_SUCCESS:
        reports = []
        for report_path in sorted(Path("results").glob("*/openfold3/prediction_report.tsv")):
            manifest = report_path.parent.parent.name
            rows = prediction_status(manifest)
            reports.append(format_report(manifest, rows))
        body = f"""
Snakemake Monday pipeline finished without errors.

Host:              {socket.gethostname()}
Working directory: {Path.cwd()}
Snakemake log:     {log}

{chr(10).join(reports) if reports else '(no prediction reports found)'}
"""
        try:
            send_email("[modpro] Snakemake OpenFold3 Monday pipeline complete", body)
        except Exception as e:
            print(f"Failed to send success email: {e}")

