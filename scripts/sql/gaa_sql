  THEN "Bvic" WHEN I.isl_ha_genetic_group LIKE "Y%" AND I.isl_type = "B" THEN "Byam" 
  END as subtype,A.protein, A.variant_hash,count(DISTINCT I.cdc_id) as total_cdc_hash_count FROM gaa.alignments_rough_merge A 
  INNER JOIN gaa.isolate_standard_rough_merge I 
  ON A.isolate_hash = I.isolate_hash WHERE A.cds_id IS NOT NULL 
    AND ((A.ctype IN ('A_HA_H3', 'A_NA_N2', 'A_MP', 'A_NP', 'A_NS', 'A_PA','A_PB1','A_PB2') 
AND A.reference_id = 'HK4801') OR (A.ctype IN ('A_HA_H1', 'A_NA_N1') AND A.reference_id = 'CALI07') 
OR (A.ctype IN ('B_HA', 'B_NS') AND A.reference_id = 'BRISBANE60') OR (A.ctype IN ('B_MP', 'B_NA','B_NP','B_PA','B_PB1','B_PB2') 
AND A.reference_id = 'PHUKET3073')) AND I.reason_for_submission = "surveillance" AND I.host_common_name = "human" 
AND A.protein = 'HA' GROUP BY CASE WHEN I.isl_ha_genetic_group LIKE "3C%" AND I.isl_ha_type like "%H3%" 
