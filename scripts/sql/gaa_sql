  count(DISTINCT I.case_id) as global_hash_count_date_range FROM gaa.alignments_rough_merge A 
 INNER JOIN gaa.isolate_standard_rough_merge I ON A.isolate_hash = I.isolate_hash 
  WHERE A.cds_id IS NOT NULL AND ((A.ctype IN ('A_HA_H3', 'A_NA_N2', 'A_MP', 'A_NP', 'A_NS','A_PA', 'A_PB1', 'A_PB2') AND A.reference_id = 'HK4801') 
