  WHEN I.isl_ha_genetic_group LIKE "Y%" AND I.isl_type = "B" THEN "Byam" END, 
  A.protein, A.variant_hash, concat(cast(TO_DATE('{date_start}') AS STRING), ":",  cast(TO_DATE('{date_start}') AS STRING)) ORDER BY count(DISTINCT I.case_id) DESC 
) master_hash_date_delim LEFT OUTER JOIN (SELECT CASE WHEN I.isl_ha_genetic_group LIKE "3C%" AND I.isl_ha_type like "%H3%" 
