OR (A.ctype IN ('B_MP', 'B_NA', 'B_NP', 'B_PA', 'B_PB1','B_PB2') AND A.reference_id = 'PHUKET3073')) 
AND I.reason_for_submission = "surveillance" AND I.collection_date BETWEEN TO_DATE('2025-01-01') AND TO_DATE('2024-04-16') AND A.protein = 'HA' 
  GROUP BY CASE WHEN I.isl_ha_genetic_group LIKE "3C%" AND I.isl_ha_type like "%H3%" THEN "H3" WHEN I.isl_ha_genetic_group LIKE "6B%" AND I.isl_ha_type like "%H1%" 
